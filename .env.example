# =============================================================================
# ABS IMMO & SERVICES — back-office (abs-immo-backoffice)
# Copier vers `.env.local` (jamais versionné) et renseigner les valeurs.
# Toutes ces variables sont PUBLIQUES : elles sont intégrées au bundle JavaScript.
# Ne jamais placer ici de clé `service_role` / `sb_secret_…` : l'application
# refuse de démarrer si elle en détecte une.
# =============================================================================

# Projet Supabase commun avec le site public (Dashboard > Project Settings > API Keys).
# Local (pile du dépôt abs-immo-backend) : http://127.0.0.1:54621 et la clé
# publishable affichée par `npx supabase status` dans abs-immo-backend.
VITE_SUPABASE_URL=https://sasssoloprjakfysajvt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Ancienne clé publique `anon` (JWT) : acceptée en repli si la clé publishable n'est pas définie.
# VITE_SUPABASE_ANON_KEY=

# URL publique du site vitrine, sans « / » final (liens « Voir sur le site »).
VITE_PUBLIC_SITE_URL=https://www.abs-immo.sn
